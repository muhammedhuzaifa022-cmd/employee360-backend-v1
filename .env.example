# =====================================================================
# Employee360 backend settings
# Copy this file to ".env" and fill in your own values.
# NEVER share or commit the real .env file.
# =====================================================================

# ---- General ----
APP_NAME=Employee360 API
APP_ENV=development
DEBUG=true

# ---- Database ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://e360_user:CHANGE_ME@localhost:5432/employee360
TEST_DATABASE_URL=postgresql+psycopg://e360_user:CHANGE_ME@localhost:5432/employee360_test

# ---- Security (used from Module 3) ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Login protection ----
# After this many wrong passwords within the window, login is blocked for a while.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- Web browser access (CORS) ----
# Comma-separated list of web addresses allowed to call the API from a browser.
# Mobile apps are NOT affected by this setting.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ---- Company ----
COMPANY_TIMEZONE=Asia/Kolkata

# ---- Mobile app versions (for the future Android / iOS apps) ----
MIN_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
